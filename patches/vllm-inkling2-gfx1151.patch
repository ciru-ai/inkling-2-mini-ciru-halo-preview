new file mode 100644
index 0000000..d394eeb
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/router.py
@@ -0,0 +1,142 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""ROCm single-token routing operations for Inkling 2 Mini."""
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra.hip import libdevice
+
+
+@triton.jit
+def _router_dot_pairs(X, Weight, pairs):
+    x = tl.load(X + pairs)
+    weight = tl.load(Weight + pairs)
+    dot = tl.inline_asm_elementwise(
+        "v_dot2_f32_bf16 $0, $1, $2, 0",
+        constraints="=v,v,v",
+        args=[weight, x],
+        dtype=tl.float32,
+        is_pure=True,
+        pack=1,
+    )
+    return tl.sum(dot, axis=0)
+
+
+@triton.jit
+def _router_scores_m1_kernel(X, Weight, Bias, Score, Corrected):
+    # One wave per expert uses a warp-local reduction, with no LDS or barrier.
+    row = tl.program_id(0)
+    x = X.to(tl.pointer_type(tl.uint32))
+    weight = Weight.to(tl.pointer_type(tl.uint32)) + row * 1152
+    bulk = _router_dot_pairs(x, weight, tl.arange(0, 1024))
+    tail = _router_dot_pairs(x, weight, 1024 + tl.arange(0, 128))
+    score = tl.div_rn(1.0, 1.0 + libdevice.exp(-(bulk + tail)))
+    bias = tl.load(Bias + row)
+    tl.store(Score + row, score)
+    tl.store(Corrected + row, score + bias)
+
+
+def router_scores_m1(
+    x: torch.Tensor, weight: torch.Tensor, bias: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor] | None:
+    """Return raw and bias-corrected FP32 sigmoid scores for Torch top-k."""
+    if (
+        not x.is_cuda
+        or x.shape != (1, 2304)
+        or weight.shape != (128, 2304)
+        or bias.shape != (128,)
+        or x.dtype != torch.bfloat16
+        or weight.dtype != torch.bfloat16
+        or bias.dtype != torch.float32
+        or not all(t.device == x.device and t.is_contiguous() for t in (x, weight, bias))
+        or x.data_ptr() % 4
+        or weight.data_ptr() % 4
+    ):
+        return None
+    score = x.new_empty((1, 128), dtype=torch.float32)
+    corrected = torch.empty_like(score)
+    _router_scores_m1_kernel[(128,)](
+        x, weight, bias, score, corrected, num_warps=1, enable_fp_fusion=False,
+    )
+    return score, corrected
+
+
+@triton.jit
+def _normalize_top8(selected, SCALE: tl.constexpr):
+    # ATen's ROCm contiguous width-eight sum shuffles at offsets 1, 2, 4.
+    # Adjacent pairs preserve that FP32 denominator and the original slot order.
+    even, odd = tl.split(tl.reshape(selected, (4, 2)))
+    low_pair, high_pair = tl.split(tl.reshape(even + odd, (2, 2)))
+    low_half, high_half = tl.split(low_pair + high_pair)
+    denominator = low_half + high_half + 1e-20
+    return tl.div_rn(selected, denominator) * SCALE
+
+
+@triton.jit
+def _normalize_top8_routes_kernel(Score, RouteIds, Gamma, SCALE: tl.constexpr):
+    slot = tl.arange(0, 8)
+    expert = tl.load(RouteIds + slot).to(tl.int32)
+    selected = tl.load(Score + expert)
+    tl.store(Gamma + slot, _normalize_top8(selected, SCALE))
+
+
+@triton.jit
+def _select_top8_routes_kernel(Score, Corrected, RouteIds, Gamma, SCALE: tl.constexpr):
+    expert = tl.arange(0, 128)
+    bits = tl.load(Corrected + expert).to(tl.uint32, bitcast=True)
+    magnitude = bits & 0x7fffffff
+    # The pinned Torch ROCm warp merge is descending and stable, with NaNs
+    # first. Treat both signed zeros and all NaNs as tied before adding IDs.
+    bits = tl.where(magnitude == 0, 0, bits)
+    ordered = tl.where((bits & 0x80000000) != 0, ~bits, bits ^ 0x80000000)
+    ordered = tl.where(magnitude > 0x7f800000, 0xffffffff, ordered)
+    key = (ordered.to(tl.uint64) << 7) | (127 - expert).to(tl.uint64)
+    ranked = tl.topk(key, 8)
+    ids = 127 - (ranked & 127).to(tl.int32)
+    selected = tl.load(Score + ids)
+    slot = tl.arange(0, 8)
+    tl.store(RouteIds + slot, ids.to(tl.int64))
+    tl.store(Gamma + slot, _normalize_top8(selected, SCALE))
+
+
+def select_top8_routes_m1(
+    score: torch.Tensor, corrected: torch.Tensor, scale: float,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Fuse the pinned ROCm width-128 stable top-eight order and normalization."""
+    if (
+        not score.is_cuda
+        or corrected.device != score.device
+        or any(t.shape != (1, 128) or t.dtype != torch.float32 or not t.is_contiguous()
+               for t in (score, corrected))
+    ):
+        raise ValueError("expected contiguous M1 FP32 raw and corrected scores")
+
+    ids = score.new_empty((1, 8), dtype=torch.int64)
+    gamma = score.new_empty((1, 8))
+    _select_top8_routes_kernel[(1,)](
+        score, corrected, ids, gamma, scale, num_warps=1, enable_fp_fusion=False,
+    )
+    return ids, gamma
+
+
+def normalize_top8_routes(
+    score: torch.Tensor, route_ids: torch.Tensor, scale: float,
+) -> torch.Tensor:
+    """Gather uncorrected scores by Torch's top-k IDs and normalize in slot order."""
+    if (
+        score.shape != (1, 128)
+        or score.dtype != torch.float32
+        or route_ids.shape != (1, 8)
+        or route_ids.dtype != torch.int64
+        or not score.is_contiguous()
+        or not route_ids.is_contiguous()
+        or score.device != route_ids.device
+    ):
+        raise ValueError("expected contiguous M1 FP32 scores and int64 top-eight IDs")
+
+    gamma = torch.empty_like(route_ids, dtype=score.dtype)
+    _normalize_top8_routes_kernel[(1,)](
+        score, route_ids, gamma, scale, num_warps=1, enable_fp_fusion=False,
+    )
+    return gamma
diff --git a/vllm/models/inkling2/amd/ops/router_m8.py b/vllm/models/inkling2/amd/ops/router_m8.py
new file mode 100644
index 0000000..c4d2d18
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/router_m8.py
@@ -0,0 +1,109 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""M8 sigmoid, stable top-eight routing, and expert-block packing on ROCm."""
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra.hip import libdevice
+
+
+@triton.jit
+def _max(lhs, rhs):
+    return tl.maximum(lhs, rhs)
+
+
+@triton.jit
+def _min(lhs, rhs):
+    return tl.minimum(lhs, rhs)
+
+
+@triton.jit
+def _pack_routes_m8(ids, Sorted, Experts, Padded):
+    # Each expert gets one M16 block: there is at most one route per token.
+    routes = tl.arange(0, 64)
+    by_expert = tl.sort((tl.reshape(ids, (64,)) << 6) | routes, descending=False)
+    expert = by_expert >> 6
+    previous = tl.gather(expert, tl.maximum(routes - 1, 0), 0)
+    new_group = (routes == 0) | (expert != previous)
+    block = tl.cumsum(new_group.to(tl.int32)) - 1
+    start = tl.associative_scan(tl.where(new_group, routes, 0), 0, _max)
+    tl.store(Sorted + block * 16 + routes - start, by_expert & 63)
+    tl.store(Experts + block, expert, new_group)
+
+    # Assign each block's padding to its first live route. The writes are
+    # disjoint from all live routes and require no ordering between waves.
+    marks = tl.where(new_group, routes, 64)
+    next_mark = tl.gather(marks, tl.minimum(routes + 1, 63), 0)
+    next_mark = tl.where(routes < 63, next_mark, 64)
+    end = tl.associative_scan(next_mark, 0, _min, reverse=True)
+    slot = tl.arange(0, 16)
+    padding = new_group[:, None] & (slot[None, :] >= (end - routes)[:, None])
+    tl.store(Sorted + block[:, None] * 16 + slot[None, :], 64, padding)
+    tl.store(Padded, tl.sum(new_group.to(tl.int32)) * 16)
+
+
+@triton.jit
+def _route_m8(Score, Bias, Ids, Gamma, Sorted, Experts, Padded,
+              SCALE: tl.constexpr, ALIGN: tl.constexpr, SIGMOID: tl.constexpr):
+    row = tl.arange(0, 8)
+    expert = tl.arange(0, 128)
+    src = tl.load(Score + row[:, None] * 128 + expert[None, :])
+    if SIGMOID:
+        src = tl.div_rn(1.0, 1.0 + libdevice.exp(-src))
+    bias = tl.load(Bias + expert)
+    bits = (src + bias[None, :]).to(tl.uint32, bitcast=True)
+    magnitude = bits & 0x7fffffff
+    # Match the ROCm 128-column stable descending warp merge used by Torch.
+    bits = tl.where(magnitude == 0, 0, bits)
+    ordered = tl.where((bits & 0x80000000) != 0, ~bits, bits ^ 0x80000000)
+    ordered = tl.where(magnitude > 0x7f800000, 0xffffffff, ordered)
+    key = (ordered.to(tl.uint64) << 7) | (127 - expert[None, :]).to(tl.uint64)
+    ranked = tl.topk(key, 8)
+    ids = 127 - (ranked & 127).to(tl.int32)
+    selected = tl.gather(src, ids, 1)
+
+    # Preserve the width-eight normalization's FP32 adjacent-pair sum.
+    even, odd = tl.split(tl.reshape(selected, (8, 4, 2)))
+    low_pair, high_pair = tl.split(tl.reshape(even + odd, (8, 2, 2)))
+    low_half, high_half = tl.split(low_pair + high_pair)
+    denominator = low_half + high_half + 1e-20
+    gamma = tl.div_rn(selected, denominator[:, None]) * SCALE
+    slot = row[:, None] * 8 + tl.arange(0, 8)[None, :]
+    tl.store(Ids + slot, ids.to(tl.int64))
+    tl.store(Gamma + slot, gamma)
+    if ALIGN:
+        _pack_routes_m8(ids, Sorted, Experts, Padded)
+
+
+def route_m8(logits, bias, scale, mode):
+    """Use the original FP32 GEMM logits and optionally emit a fused M16 plan."""
+    if (
+        mode not in ("tail", "align", "select")
+        or logits.shape != (8, 128)
+        or bias.shape != (128,)
+        or logits.dtype != torch.float32
+        or bias.dtype != torch.float32
+        or not logits.is_cuda
+        or bias.device != logits.device
+        or not logits.is_contiguous()
+        or not bias.is_contiguous()
+    ):
+        raise ValueError("Expected contiguous ROCm FP32 M8-128 logits and 128 biases")
+
+    align = mode != "tail"
+    sigmoid = mode != "select"
+    ids = torch.empty((8, 8), dtype=torch.int64, device=logits.device)
+    gamma = torch.empty((8, 8), dtype=torch.float32, device=logits.device)
+    plan = None
+    if align:
+        sorted_ids = torch.empty((1024,), dtype=torch.int32, device=logits.device)
+        experts = torch.empty((64,), dtype=torch.int32, device=logits.device)
+        padded = torch.empty((1,), dtype=torch.int32, device=logits.device)
+        plan = (sorted_ids, experts, padded)
+    _route_m8[(1,)](
+        logits if sigmoid else logits.sigmoid(), bias, ids, gamma,
+        *(plan if align else (None, None, None)),
+        SCALE=scale, ALIGN=align, SIGMOID=sigmoid, num_warps=2, enable_fp_fusion=False,
+    )
+    return ids, gamma, plan
