index 0000000..f2aa7cf
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/grouped_decode.py
@@ -0,0 +1,348 @@
+"""Direct top-eight W4A16 expert projections for gfx1151."""
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra import libdevice
+
+from .expert_e2m1_g16 import _e2m1_doubled_pair
+from .expert_nvfp4 import _positive_e4m3fn
+
+
+TOP_K = 8
+
+
+def projection_activation_layout(x, route_ids, width):
+    """Return the activation row stride and the number of routes sharing a row."""
+    if (route_ids.ndim not in (1, 2) or route_ids.shape[-1] != TOP_K or not route_ids.numel()
+            or route_ids.dtype not in (torch.int32, torch.int64) or not route_ids.is_contiguous()):
+        raise ValueError("routes must be contiguous int32 or int64 [8] or nonempty [M, 8]")
+    if x.ndim and x.dtype == torch.bfloat16 and x.stride(-1) == 1:
+        if x.shape == (*route_ids.shape[:-1], width):
+            return (0, 1) if x.ndim == 1 else (x.stride(0), TOP_K)
+        if x.shape == (*route_ids.shape, width) and x.is_contiguous():
+            return width, 1
+    raise ValueError("activation must be BF16 with one vector per token or per route")
+
+
+@triton.jit
+def _doubled_e2m1_bf16_pair(packed):
+    selector = (packed & 7) | ((packed << 12) & 0x00070000)
+    fields = tl.inline_asm_elementwise(
+        "v_perm_b32 $0, $1, $2, $3",
+        constraints="=v,v,v,v",
+        args=[0x85848382, 0x81807E00, selector],
+        dtype=tl.uint32, is_pure=True, pack=1,
+    )
+    # The compact table encodes BF16 bits for magnitudes 0,1,2,3,4,6,8,12.
+    # Bit 6 supplies both bits 12 and 13 of each BF16 lane.
+    mantissa_exponent = ((fields & 0x007F007F) << 6) | ((fields & 0x00C000C0) << 7)
+    signs = ((packed & 8) << 12) | ((packed & 128) << 24)
+    return mantissa_exponent | signs
+
+
+@triton.jit
+def _softcap(x, CAP: tl.constexpr):
+    return CAP * libdevice.tanh(tl.div_rn(x, CAP))
+
+
+@triton.jit
+def _route_softcap(gate, up, gamma, GATE_CAP: tl.constexpr, UP_CAP: tl.constexpr):
+    sigmoid = 1.0 / (1.0 + tl.exp(-gate))
+    return ((_softcap(gate, GATE_CAP) * sigmoid) * _softcap(up, UP_CAP)) * gamma
+
+
+@triton.jit
+def _grouped_projection(
+    X, Packed, Scales, RouteIds, Outer, RowScales, Table, Out,
+    N: tl.constexpr, GROUPS: tl.constexpr, GROUP_BYTES: tl.constexpr,
+    BLOCK_ROWS: tl.constexpr, BLOCK_GROUPS: tl.constexpr, EXPERTS: tl.constexpr,
+    X_STRIDE: tl.constexpr, ROUTES_PER_INPUT: tl.constexpr,
+    FORMAT: tl.constexpr, NORMAL_SCALES: tl.constexpr, BF16_DOT2: tl.constexpr = False,
+    Gamma=None, FUSED_ACTIVATION: tl.constexpr = False,
+    GATE_CAP: tl.constexpr = 0.0, UP_CAP: tl.constexpr = 0.0,
+    STREAM_WEIGHTS: tl.constexpr = False,
+):
+    slot = tl.program_id(1)
+    expert = tl.load(RouteIds + slot)
+    expert_valid = (expert >= 0) & (expert < EXPERTS)
+    rows = tl.program_id(0) * BLOCK_ROWS + tl.arange(0, BLOCK_ROWS)
+    byte = tl.arange(0, BLOCK_GROUPS * GROUP_BYTES)
+    row_mask = rows < N
+    byte_mask = byte < GROUPS * GROUP_BYTES
+    weight_mask = row_mask & expert_valid
+    bank_rows = expert.to(tl.int64) * N + rows
+
+    x = X + (slot // ROUTES_PER_INPUT) * X_STRIDE
+    if BF16_DOT2:
+        pair_x = tl.load(x.to(tl.pointer_type(tl.uint32)) + byte, byte_mask, other=0)
+    else:
+        even = tl.load(x + 2 * byte, byte_mask, other=0).to(tl.float32)
+        odd = tl.load(x + 2 * byte + 1, byte_mask, other=0).to(tl.float32)
+    codes = tl.load(
+        Packed + bank_rows[:, None] * (GROUPS * GROUP_BYTES) + byte[None, :],
+        weight_mask[:, None] & byte_mask[None, :], other=0,
+        cache_modifier=".cg" if STREAM_WEIGHTS else "",
+    ).to(tl.int32)
+    if BF16_DOT2:
+        pair_w = _doubled_e2m1_bf16_pair(codes.to(tl.uint32))
+        pair_dot = tl.inline_asm_elementwise(
+            "v_dot2_f32_bf16 $0, $1, $2, 0",
+            constraints="=v,v,v",
+            args=[pair_w, tl.broadcast_to(pair_x[None, :], (BLOCK_ROWS, BLOCK_GROUPS * GROUP_BYTES))],
+            dtype=tl.float32, is_pure=True, pack=1,
+        )
+    else:
+        if FORMAT == "source-e2m1":
+            low, high = _e2m1_doubled_pair(codes.to(tl.uint32))
+        elif FORMAT == "flash-c1":
+            low = (codes & 15).to(tl.float32)
+            high = (codes >> 4).to(tl.float32)
+        else:
+            low = (((codes & 15) ^ 8) - 8).to(tl.float32)
+            high = (((codes >> 4) ^ 8) - 8).to(tl.float32)
+        pair_dot = low * even[None, :] + high * odd[None, :]
+    group_dot = tl.sum(tl.reshape(pair_dot, (BLOCK_ROWS, BLOCK_GROUPS, GROUP_BYTES)), 2)
+
+    groups = tl.arange(0, BLOCK_GROUPS)
+    scale_mask = weight_mask[:, None] & (groups[None, :] < GROUPS)
+    metadata = tl.load(Scales + bank_rows[:, None] * GROUPS + groups[None, :], scale_mask, other=0)
+    if FORMAT == "source-e2m1":
+        scale_bytes = metadata.to(tl.int32)
+        if NORMAL_SCALES:
+            # Finite positive normals map to BF16 by moving the mantissa and rebiasing.
+            bits = ((scale_bytes << 4) + (120 << 7)).to(tl.uint16)
+            scale = bits.to(tl.bfloat16, bitcast=True).to(tl.float32)
+        else:
+            scale = _positive_e4m3fn(scale_bytes)
+        factor = 0.5 * tl.load(Outer + expert, expert_valid, other=0)
+        result = tl.sum(group_dot * scale, 1) * factor
+    elif FORMAT == "flash-c1":
+        tags = metadata.to(tl.int32)
+        entries = Table + expert * 512 + 2 * tags
+        scale = tl.load(entries, scale_mask, other=0).to(tl.float32)
+        offset = tl.load(entries + 1, scale_mask, other=0).to(tl.float32)
+        x_sum = tl.sum(tl.reshape(even + odd, (BLOCK_GROUPS, GROUP_BYTES)), 1)
+        row_scale = tl.load(RowScales + bank_rows, weight_mask, other=0).to(tl.float32)
+        result = tl.sum(group_dot * scale + x_sum[None, :] * offset, 1) * row_scale
+    else:
+        result = tl.sum(group_dot * metadata.to(tl.float32), 1)
+
+    # Keep bounds checking on the device so valid routes require no synchronization.
+    result = tl.where(expert_valid, result, float("nan"))
+    projected = result.to(tl.bfloat16, fp_downcast_rounding="rtne")
+    if FUSED_ACTIVATION:
+        # A two-row W13 block owns one interleaved gate/up pair.
+        gate, up = tl.split(projected)
+        gamma = tl.load(Gamma + slot)
+        activated = _route_softcap(gate.to(tl.float32), up.to(tl.float32),
+                                   gamma, GATE_CAP, UP_CAP)
+        col = tl.program_id(0)
+        tl.store(Out + slot * (N // 2) + col,
+                 activated.to(tl.bfloat16, fp_downcast_rounding="rtne"))
+    else:
+        tl.store(Out + slot * N + rows, projected, row_mask)
+
+
+@triton.jit
+def _source_scaled_groups(
+    X, Packed, Scales, weight_mask, bank_rows, N_GROUPS: tl.constexpr,
+    BLOCK_ROWS: tl.constexpr, OFFSET: tl.constexpr, COUNT: tl.constexpr,
+):
+    groups = OFFSET + tl.arange(0, COUNT)
+    byte = 8 * OFFSET + tl.arange(0, 8 * COUNT)
+    even = tl.load(X + 2 * byte).to(tl.float32)
+    odd = tl.load(X + 2 * byte + 1).to(tl.float32)
+    codes = tl.load(
+        Packed + bank_rows[:, None] * (8 * N_GROUPS) + byte[None, :],
+        weight_mask[:, None], other=0,
+    ).to(tl.uint32)
+    low, high = _e2m1_doubled_pair(codes)
+    pair_dot = low * even[None, :] + high * odd[None, :]
+    group_dot = tl.sum(tl.reshape(pair_dot, (BLOCK_ROWS, COUNT, 8)), 2)
+    scale_bytes = tl.load(
+        Scales + bank_rows[:, None] * N_GROUPS + groups[None, :],
+        weight_mask[:, None], other=0,
+    ).to(tl.int32)
+    bits = ((scale_bytes << 4) + (120 << 7)).to(tl.uint16)
+    return group_dot * bits.to(tl.bfloat16, bitcast=True).to(tl.float32)
+
+
+@triton.jit
+def _source_short_k_projection(
+    X, Packed, Scales, RouteIds, Outer, Out,
+    N: tl.constexpr, GROUPS: tl.constexpr, BLOCK_ROWS: tl.constexpr, EXPERTS: tl.constexpr,
+    X_STRIDE: tl.constexpr,
+):
+    slot = tl.program_id(1)
+    expert = tl.load(RouteIds + slot)
+    expert_valid = (expert >= 0) & (expert < EXPERTS)
+    rows = tl.program_id(0) * BLOCK_ROWS + tl.arange(0, BLOCK_ROWS)
+    row_mask = rows < N
+    weight_mask = row_mask & expert_valid
+    bank_rows = expert.to(tl.int64) * N + rows
+    x = X + slot * X_STRIDE
+
+    # Both Inkling inputs have exactly eight times as many full groups as
+    # tail groups. Accumulate them within one program without padded K work.
+    TAIL: tl.constexpr = GROUPS // 9
+    MAIN: tl.constexpr = 8 * TAIL
+    main = _source_scaled_groups(x, Packed, Scales, weight_mask, bank_rows, GROUPS, BLOCK_ROWS, 0, MAIN)
+    tail = _source_scaled_groups(x, Packed, Scales, weight_mask, bank_rows, GROUPS, BLOCK_ROWS, MAIN, TAIL)
+    # Fold the nonzero upper-half terms into the leading group slots before
+    # the final reduction. Padding would only add zeros to the other slots.
+    main = tl.reshape(main, (BLOCK_ROWS, 8, TAIL))
+    merged = main + tl.where(tl.arange(0, 8)[None, :, None] == 0, tail[:, None, :], 0.0)
+    dot = tl.sum(tl.reshape(merged, (BLOCK_ROWS, MAIN)), 1)
+    factor = 0.5 * tl.load(Outer + expert, expert_valid, other=0)
+    result = tl.where(expert_valid, dot * factor, float("nan"))
+    tl.store(Out + slot * N + rows, result.to(tl.bfloat16, fp_downcast_rounding="rtne"), row_mask)
+
+
+def grouped_projection(
+    x, packed, scales, route_ids, *, format, outer_scales=None, flash_aux=None,
+    normal_scales=False, tile_rows=4, short_k=False, bf16_dot2=False, fused_activation=None,
+    stream_weights=False,
+):
+    """Project BF16 inputs into BF16 route slots.
+
+    With routes [8], accept x[K] or x[8, K] and return [8, N].
+    With routes [M, 8], accept x[M, K] or x[M, 8, K] and return [M, 8, N].
+    The byte bank is [E, N, K/2], low nibble first. s4-g32 uses BF16 [E, N, K/32] scales and
+    two's-complement nibbles. source-e2m1 uses raw positive E4M3FN scales
+    [E, N, K/16] and FP32 [E] amax/denominator ratios. Enable normal_scales
+    only after checking scale bytes are all in [8, 126] at load time.
+    short_k selects an M1 source kernel for normal scales at K=1152 or K=2304.
+    bf16_dot2 keeps the baseline reduction geometry and uses a packed BF16 dot.
+    stream_weights applies the gfx1151 streaming hint to DOT2 weight bytes.
+    Fused M1 source W13 accepts (gamma, gate_cap, up_cap) and returns [8, N/2].
+    flash-c1 uses U8 [E, N, K/16] tags and flash_aux=(FP16 [E, N] row
+    multipliers, FP16 [E, 256, 2] affine tables).
+    """
+    if format not in ("s4-g32", "source-e2m1", "flash-c1") or tile_rows not in (2, 4):
+        raise ValueError("invalid grouped projection format or output tile")
+    if packed.ndim != 3 or packed.dtype != torch.uint8:
+        raise ValueError("packed weights must be uint8 [E, N, K/2]")
+    experts, rows, packed_width = packed.shape
+    width = 2 * packed_width
+    group_size = 32 if format == "s4-g32" else 16
+    scale_dtype = torch.bfloat16 if format == "s4-g32" else torch.uint8
+    groups = width // group_size
+    if not experts or not rows or not groups or width % group_size:
+        raise ValueError("packed dimensions must be nonempty and aligned to the group size")
+    x_stride, routes_per_input = projection_activation_layout(x, route_ids, width)
+    if scales.shape != (experts, rows, groups) or scales.dtype != scale_dtype:
+        raise ValueError("scales must match the packed format and geometry")
+    operands = [x, packed, scales, route_ids]
+    row_scales = table = None
+    if format == "source-e2m1":
+        if outer_scales is None or outer_scales.shape != (experts,) or outer_scales.dtype != torch.float32:
+            raise ValueError("source E2M1 requires FP32 outer scales [E]")
+        operands.append(outer_scales)
+    if format == "flash-c1":
+        if flash_aux is None:
+            raise ValueError("Flash C1 requires row multipliers and affine tables")
+        row_scales, table = flash_aux
+        if row_scales.shape != (experts, rows) or table.shape != (experts, 256, 2):
+            raise ValueError("Flash C1 expects row multipliers [E, N] and tables [E, 256, 2]")
+        if row_scales.dtype != torch.float16 or table.dtype != torch.float16:
+            raise ValueError("Flash C1 metadata must be FP16")
+        operands.extend((row_scales, table))
+    use_m1_source = format == "source-e2m1" and normal_scales and route_ids.ndim == 1 and groups in (72, 144)
+    use_dot2 = bf16_dot2 and use_m1_source and x.data_ptr() % 4 == 0
+    if stream_weights and not use_dot2:
+        raise ValueError("streaming weight loads require M1 source BF16 DOT2")
+    gamma, gate_cap, up_cap = None, 0.0, 0.0
+    out_rows = rows
+    if fused_activation is not None:
+        gamma, gate_cap, up_cap = fused_activation
+        if not use_dot2 or groups != 144 or tile_rows != 2 or rows % 2:
+            raise ValueError("fused activation requires M1 source W13 with a packed BF16 dot and row pairs")
+        if gamma.shape != route_ids.shape or gamma.dtype != torch.float32 or gate_cap <= 0 or up_cap <= 0:
+            raise ValueError("fused activation requires FP32 route weights and positive softcaps")
+        operands.append(gamma)
+        out_rows = rows // 2
+    if any(not t.is_contiguous() or t.device != x.device for t in operands):
+        raise ValueError("all projection operands must be contiguous on one device")
+
+    out = x.new_empty((*route_ids.shape, out_rows))
+    grid = (triton.cdiv(rows, tile_rows), route_ids.numel())
+    if short_k and not bf16_dot2 and use_m1_source:
+        _source_short_k_projection[grid](
+            x, packed, scales, route_ids, outer_scales, out,
+            N=rows, GROUPS=groups, BLOCK_ROWS=tile_rows, EXPERTS=experts, X_STRIDE=x_stride,
+            num_warps=4,
+        )
+        return out
+    _grouped_projection[grid](
+        x, packed, scales, route_ids, outer_scales, row_scales, table, out,
+        N=rows, GROUPS=groups, GROUP_BYTES=group_size // 2,
+        BLOCK_ROWS=tile_rows, BLOCK_GROUPS=triton.next_power_of_2(groups), EXPERTS=experts,
+        X_STRIDE=x_stride, ROUTES_PER_INPUT=routes_per_input,
+        FORMAT=format, NORMAL_SCALES=normal_scales, BF16_DOT2=use_dot2,
+        Gamma=gamma, FUSED_ACTIVATION=fused_activation is not None,
+        GATE_CAP=gate_cap, UP_CAP=up_cap,
+        STREAM_WEIGHTS=stream_weights,
+        num_warps=4,
+    )
+    return out
+
+
+@triton.jit
+def _inkling_softcap(W13, Gamma, Out, N: tl.constexpr, BLOCK: tl.constexpr,
+                     GATE_CAP: tl.constexpr, UP_CAP: tl.constexpr):
+    slot = tl.program_id(1)
+    cols = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    pair = W13 + 2 * (slot * N + cols)
+    gate = tl.load(pair, cols < N, other=0).to(tl.float32)
+    up = tl.load(pair + 1, cols < N, other=0).to(tl.float32)
+    gamma = tl.load(Gamma + slot)
+    activated = _route_softcap(gate, up, gamma, GATE_CAP, UP_CAP)
+    tl.store(Out + slot * N + cols, activated.to(tl.bfloat16, fp_downcast_rounding="rtne"), cols < N)
+
+
+def inkling_softcap(w13, route_gamma, *, gate_cap=4.0, up_cap=25.0):
+    """Apply softcapped SwiGLU to interleaved BF16 rows, weighting before BF16 cast."""
+    if (w13.ndim not in (2, 3) or w13.shape[-2] != TOP_K
+            or not w13.numel() or w13.shape[-1] % 2):
+        raise ValueError("gate/up must have shape [8, 2*N] or [M, 8, 2*N] with interleaved pairs")
+    if route_gamma.shape != w13.shape[:-1] or route_gamma.dtype != torch.float32:
+        raise ValueError("FP32 route gamma must match the gate/up route slots")
+    if w13.dtype != torch.bfloat16 or not w13.is_contiguous() or not route_gamma.is_contiguous():
+        raise ValueError("the epilogue requires contiguous BF16 gate/up and contiguous gamma")
+    if w13.device != route_gamma.device or gate_cap <= 0 or up_cap <= 0:
+        raise ValueError("the epilogue requires one device and positive softcaps")
+
+    width = w13.shape[-1] // 2
+    out = w13.new_empty((*route_gamma.shape, width))
+    block = 128
+    _inkling_softcap[(triton.cdiv(width, block), route_gamma.numel())](
+        w13, route_gamma, out, width, block, gate_cap, up_cap, num_warps=4,
+    )
+    return out
+
+
+@triton.jit
+def _inkling_reduce(Down, Out, N: tl.constexpr, BLOCK: tl.constexpr, ROUTES: tl.constexpr):
+    token = tl.program_id(1)
+    cols = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    acc = tl.full((BLOCK,), 0.0, tl.float32)
+    for slot in tl.static_range(ROUTES):
+        acc += tl.load(Down + (token * ROUTES + slot) * N + cols, cols < N, other=0).to(tl.float32)
+    tl.store(Out + token * N + cols, acc.to(tl.bfloat16, fp_downcast_rounding="rtne"), cols < N)
+
+
+def inkling_reduce(w2):
+    """Sum already weighted BF16 expert rows in route order and round once to BF16."""
+    if w2.ndim not in (2, 3) or w2.shape[-2] != TOP_K or not w2.numel():
+        raise ValueError("down projections must have shape [8, N] or [M, 8, N]")
+    if w2.dtype != torch.bfloat16 or not w2.is_contiguous():
+        raise ValueError("down projections must be contiguous BF16")
+
+    width = w2.shape[-1]
+    out = w2.new_empty((*w2.shape[:-2], width))
+    block = 128
+    _inkling_reduce[(triton.cdiv(width, block), out.numel() // width)](
+        w2, out, width, block, TOP_K, num_warps=4,
+    )
+    return out
diff --git a/vllm/models/inkling2/amd/ops/groupwise_w6_head.py b/vllm/models/inkling2/amd/ops/groupwise_w6_head.py
new file mode 100644
index 0000000..137fc2d
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/groupwise_w6_head.py
@@ -0,0 +1,442 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Standalone gfx1151 signed W6A16 GEMV with K32 or K64 scales."""
+
+import os
+from math import isfinite
+
+import torch
+from triton.experimental import gluon
+from triton.experimental.gluon import language as gl
+from triton.experimental.gluon.language.extra import libdevice
+
+from vllm.triton_utils import triton
+
+
+_WIDTHS = (2304, 3072)
+_GROUP_SIZES = (32, 64)
+_RECORD_SIZE = 16
+
+
+@torch.no_grad()
+def pack_groupwise_w6_head(
+    weight: torch.Tensor, *, group_size: int = 64,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Store 16 signed codes in one 64-bit and one 32-bit word per record."""
+    if weight.ndim != 2 or weight.shape[1] not in (*_WIDTHS, 256) or weight.dtype != torch.bfloat16:
+        raise ValueError("Expected BF16 weights with width 256, 2304 or 3072")
+    if group_size not in _GROUP_SIZES:
+        raise ValueError("W6 scale groups must contain 32 or 64 weights")
+
+    n, width = weight.shape
+    record_count = width // _RECORD_SIZE
+    group_count = width // group_size
+    pair = torch.empty((n, record_count), dtype=torch.int64, device=weight.device)
+    third = torch.empty((n, record_count), dtype=torch.int32, device=weight.device)
+    scales = torch.empty((n, group_count), dtype=torch.float16, device=weight.device)
+    min_scale = torch.finfo(torch.float16).tiny * torch.finfo(torch.float16).eps
+    chunk_rows = 2048
+    shifts = torch.arange(0, 30, 6, device=weight.device)
+    for start in range(0, n, chunk_rows):
+        stop = min(start + chunk_rows, n)
+        values = weight[start:stop].float().reshape(-1, group_count, group_size)
+        scale = (values.abs().amax(dim=-1) / 31).clamp_min_(min_scale).half()
+        codes = values.div_(scale.float()[:, :, None]).round_().clamp_(-31, 31)
+        records = (codes.to(torch.int64) & 63).reshape(-1, record_count, _RECORD_SIZE)
+        last = records[:, :, 15]
+
+        # Five six-bit codes per dword, and two bits of the last code in each.
+        word0 = (records[:, :, :5] << shifts).sum(dim=2) | ((last & 3) << 30)
+        word1 = (records[:, :, 5:10] << shifts).sum(dim=2) | (((last >> 2) & 3) << 30)
+        word2 = (records[:, :, 10:15] << shifts).sum(dim=2) | ((last >> 4) << 30)
+        pair[start:stop].copy_(word0 | (word1 << 32))
+        third[start:stop].copy_(word2)
+        scales[start:stop].copy_(scale)
+    return pair, third, scales
+
+
+@gluon.jit
+def _w6_dot2_record(codes, x, ROWS: gl.constexpr, ROW_LANE: gl.constexpr):
+    # Codes fit exactly in BF16. The dot replaces the first adjacent-pair
+    # reduction while keeping the remaining FP32 tree and the scale position.
+    pair_shape: gl.constexpr = (ROWS, 32, 8, 2)
+    x, _ = gl.broadcast(x[None, :, :], codes)
+    c0, c1 = gl.split(gl.reshape(codes.to(gl.bfloat16), pair_shape))
+    x0, x1 = gl.split(gl.reshape(x, pair_shape))
+    c_pair = c0.to(gl.uint16, bitcast=True).to(gl.uint32) | (
+        c1.to(gl.uint16, bitcast=True).to(gl.uint32) << 16
+    )
+    x_pair = x0.to(gl.uint16, bitcast=True).to(gl.uint32) | (
+        x1.to(gl.uint16, bitcast=True).to(gl.uint32) << 16
+    )
+    sums = gl.inline_asm_elementwise(
+        "v_dot2_f32_bf16 $0, $1, $2, 0",
+        constraints="=v,v,v", args=[c_pair, x_pair],
+        dtype=gl.float32, is_pure=True, pack=1,
+    )
+    return gl.convert_layout(gl.sum(sums, axis=2), ROW_LANE)
+
+
+@gluon.jit
+def _w6_tile(
+    X, Pair, Third, Scales, rows, lanes, input_cols, slots, chunk,
+    N: gl.constexpr, K: gl.constexpr, GROUP_SIZE: gl.constexpr, ROWS: gl.constexpr,
+    TAIL: gl.constexpr, USE_DOT2: gl.constexpr = False,
+):
+    records: gl.constexpr = K // 16
+    groups: gl.constexpr = K // GROUP_SIZE
+    records_per_group: gl.constexpr = GROUP_SIZE // 16
+    record = chunk * 32 + lanes
+    valid = rows[:, None] < N if N % ROWS else True
+    if TAIL:
+        valid = valid & (record[None, :] < records)
+    pair = gl.load(Pair + rows[:, None] * records + record[None, :], valid, 0)
+    word0 = pair.to(gl.uint32)
+    word1 = (pair.to(gl.uint64) >> 32).to(gl.uint32)
+    word2 = gl.load(Third + rows[:, None] * records + record[None, :], valid, 0)
+    word2 = word2.to(gl.uint32)
+    scale = gl.load(
+        Scales + rows[:, None] * groups + record[None, :] // records_per_group, valid, 0,
+    ).to(gl.float32)
+    if TAIL:
+        x = gl.load(X + chunk * 512 + input_cols, chunk * 512 + input_cols < K, 0)
+    else:
+        x = gl.load(X + chunk * 512 + input_cols)
+
+    last = (word0 >> 30) | ((word1 >> 28) & 12) | ((word2 >> 26) & 48)
+    word = gl.where(slots < 5, word0[:, :, None], gl.where(
+        slots < 10, word1[:, :, None], word2[:, :, None],
+    ))
+    word = gl.where(slots == 15, last[:, :, None], word)
+    bits = gl.where(slots == 15, 0, (slots % 5) * 6)
+    codes = (word << (26 - bits)).to(gl.int32) >> 26
+    if USE_DOT2:
+        return _w6_dot2_record(codes, x, ROWS, scale.type.layout) * scale
+    return gl.sum(codes.to(gl.float32) * x[None, :, :].to(gl.float32), axis=2) * scale
+
+
+@gluon.jit
+def _groupwise_w6_rows(
+    X, Pair, Third, Scales, Y, row_start, N: gl.constexpr, K: gl.constexpr,
+    GROUP_SIZE: gl.constexpr, ROWS: gl.constexpr, SOFT_CAP: gl.constexpr,
+):
+    # One output row per wave and one 16-code record per lane.
+    tile: gl.constexpr = gl.BlockedLayout([1, 1, 16], [1, 32, 1], [ROWS, 1, 1], [2, 1, 0])
+    row_lane: gl.constexpr = gl.SliceLayout(2, tile)
+    input_layout: gl.constexpr = gl.SliceLayout(0, tile)
+    rows = row_start + gl.arange(0, ROWS, gl.SliceLayout(1, row_lane))
+    lanes = gl.arange(0, 32, gl.SliceLayout(0, row_lane))
+    input_lanes = gl.arange(0, 32, gl.SliceLayout(1, input_layout))
+    input_slots = gl.arange(0, 16, gl.SliceLayout(0, input_layout))
+    input_cols = input_lanes[:, None] * 16 + input_slots[None, :]
+    slots = input_slots[None, :][None, :, :]
+    partial = gl.zeros((ROWS, 32), gl.float32, row_lane)
+    for chunk in range(K // 512):
+        partial += _w6_tile(
+            X, Pair, Third, Scales, rows, lanes, input_cols, slots, chunk, N, K, GROUP_SIZE, ROWS, False,
+        )
+    if K % 512:
+        partial += _w6_tile(
+            X, Pair, Third, Scales, rows, lanes, input_cols, slots, K // 512, N, K, GROUP_SIZE, ROWS, True,
+        )
+    result = gl.sum(partial, axis=1)
+    if SOFT_CAP != 0.0:
+        result = libdevice.tanh(gl.div_rn(result, SOFT_CAP)) * SOFT_CAP
+    if Y.dtype.element_ty == gl.bfloat16:
+        result = result.to(gl.bfloat16, fp_downcast_rounding="rtne")
+    gl.store(Y + rows, result, rows < N if N % ROWS else True)
+
+
+@gluon.jit
+def _groupwise_w6_head_gemv(
+    X, Pair, Third, Scales, Y, N: gl.constexpr, K: gl.constexpr, GROUP_SIZE: gl.constexpr,
+    ROWS: gl.constexpr, SOFT_CAP: gl.constexpr = 0.0,
+):
+    _groupwise_w6_rows(
+        X, Pair, Third, Scales, Y, gl.program_id(0) * ROWS, N, K, GROUP_SIZE, ROWS, SOFT_CAP,
+    )
+
+
+@gluon.jit
+def _w6_batched_chunk(
+    inputs, partials, Pair, Third, Scales, rows, lanes, input_cols, slots, chunk,
+    N: gl.constexpr, K: gl.constexpr, GROUP_SIZE: gl.constexpr, ROWS: gl.constexpr,
+    TILE_M: gl.constexpr, TAIL: gl.constexpr, USE_DOT2: gl.constexpr,
+):
+    updated = ()
+    for index in gl.static_range(TILE_M):
+        tile = _w6_tile(
+            inputs[index], Pair, Third, Scales, rows, lanes, input_cols, slots, chunk,
+            N, K, GROUP_SIZE, ROWS, TAIL, USE_DOT2,
+        )
+        updated += (partials[index] + tile,)
+    return updated
+
+
+@gluon.jit
+def _groupwise_w6_batched_rows(
+    X, Pair, Third, Scales, Y, row_start, M: gl.constexpr, N: gl.constexpr, K: gl.constexpr,
+    GROUP_SIZE: gl.constexpr, ROWS: gl.constexpr, TILE_M: gl.constexpr, SOFT_CAP: gl.constexpr,
+    USE_DOT2: gl.constexpr,
+):
+    # Keep the M1 lane layout. Each output wave owns independent
+    # accumulators for the token rows that share its decoded weights.
+    tile: gl.constexpr = gl.BlockedLayout([1, 1, 16], [1, 32, 1], [ROWS, 1, 1], [2, 1, 0])
+    row_lane: gl.constexpr = gl.SliceLayout(2, tile)
+    input_layout: gl.constexpr = gl.SliceLayout(0, tile)
+    rows = row_start + gl.arange(0, ROWS, gl.SliceLayout(1, row_lane))
+    lanes = gl.arange(0, 32, gl.SliceLayout(0, row_lane))
+    input_lanes = gl.arange(0, 32, gl.SliceLayout(1, input_layout))
+    input_slots = gl.arange(0, 16, gl.SliceLayout(0, input_layout))
+    input_cols = input_lanes[:, None] * 16 + input_slots[None, :]
+    slots = input_slots[None, :][None, :, :]
+    first_token = gl.program_id(1) * TILE_M
+    inputs = ()
+    for index in gl.static_range(TILE_M):
+        token = first_token + index
+        if M % TILE_M:
+            token = gl.minimum(token, M - 1)
+        inputs += (X + token * K,)
+
+    zero = gl.zeros((ROWS, 32), gl.float32, row_lane)
+    partials = (zero,) * TILE_M
+    for chunk in range(K // 512):
+        partials = _w6_batched_chunk(
+            inputs, partials, Pair, Third, Scales, rows, lanes, input_cols, slots, chunk,
+            N, K, GROUP_SIZE, ROWS, TILE_M, False, USE_DOT2,
+        )
+    if K % 512:
+        partials = _w6_batched_chunk(
+            inputs, partials, Pair, Third, Scales, rows, lanes, input_cols, slots, K // 512,
+            N, K, GROUP_SIZE, ROWS, TILE_M, True, USE_DOT2,
+        )
+    for index in gl.static_range(TILE_M):
+        token = first_token + index
+        result = gl.sum(partials[index], axis=1)
+        if SOFT_CAP != 0.0:
+            result = libdevice.tanh(gl.div_rn(result, SOFT_CAP)) * SOFT_CAP
+        if Y.dtype.element_ty == gl.bfloat16:
+            result = result.to(gl.bfloat16, fp_downcast_rounding="rtne")
+        valid = rows < N if N % ROWS else True
+        if M % TILE_M:
+            valid = valid & (token < M)
+        gl.store(Y + token * N + rows, result, valid)
+
+
+@gluon.jit
+def _groupwise_w6_head_batched_gemv(
+    X, Pair, Third, Scales, Y, M: gl.constexpr, N: gl.constexpr, K: gl.constexpr,
+    GROUP_SIZE: gl.constexpr, ROWS: gl.constexpr, TILE_M: gl.constexpr, SOFT_CAP: gl.constexpr,
+    USE_DOT2: gl.constexpr = False,
+):
+    _groupwise_w6_batched_rows(
+        X, Pair, Third, Scales, Y, gl.program_id(0) * ROWS,
+        M, N, K, GROUP_SIZE, ROWS, TILE_M, SOFT_CAP, USE_DOT2,
+    )
+
+
+@gluon.jit
+def _groupwise_w6_qkv_batched_gemv(
+    XQ, XK, XV, Pair, Third, Scales, Y,
+    Q_END: gl.constexpr, K_END: gl.constexpr, M: gl.constexpr, N: gl.constexpr, K: gl.constexpr,
+    GROUP_SIZE: gl.constexpr, ROWS: gl.constexpr, TILE_M: gl.constexpr,
+    USE_DOT2: gl.constexpr = False,
+):
+    row_start = gl.program_id(0) * ROWS
+    x = gl.where(row_start < Q_END, XQ, gl.where(row_start < K_END, XK, XV))
+    _groupwise_w6_batched_rows(
+        x, Pair, Third, Scales, Y, row_start, M, N, K, GROUP_SIZE, ROWS, TILE_M, 0.0, USE_DOT2,
+    )
+
+
+@gluon.jit
+def _groupwise_w6_qkv_gemv(
+    XQ, XK, XV, Pair, Third, Scales, Y,
+    Q_END: gl.constexpr, K_END: gl.constexpr, N: gl.constexpr, K: gl.constexpr,
+    GROUP_SIZE: gl.constexpr, ROWS: gl.constexpr,
+):
+    row_start = gl.program_id(0) * ROWS
+    # Every row in a workgroup belongs to the same activation.
+    x = gl.where(row_start < Q_END, XQ, gl.where(row_start < K_END, XK, XV))
+    _groupwise_w6_rows(x, Pair, Third, Scales, Y, row_start, N, K, GROUP_SIZE, ROWS, 0.0)
+
+
+def _packed_group_size(
+    x: torch.Tensor, pair: torch.Tensor, third: torch.Tensor, scales: torch.Tensor,
+) -> int:
+    width = x.shape[1]
+    if (
+        pair.ndim != 2 or pair.shape[1] != width // _RECORD_SIZE or pair.dtype != torch.int64
+        or third.shape != pair.shape or third.dtype != torch.int32
+        or scales.ndim != 2 or scales.shape[0] != pair.shape[0] or scales.dtype != torch.float16
+        or any(t.device != x.device or not t.is_contiguous() for t in (pair, third, scales))
+    ):
+        raise ValueError("Expected contiguous packed signed W6 weights and FP16 scales")
+    if scales.shape[1] == width // 64:
+        return 64
+    if scales.shape[1] == width // 32:
+        return 32
+    raise ValueError("W6 packed scale count must match G32 or G64")
+
+
+def groupwise_w6_head_linear(
+    x: torch.Tensor, pair: torch.Tensor, third: torch.Tensor, scales: torch.Tensor,
+    *, out_dtype: torch.dtype = torch.float32, num_warps: int = 4, soft_cap: float = 0.0,
+) -> torch.Tensor:
+    """Project one BF16 token with FP32 accumulation and optional FP32 softcap."""
+    if x.ndim != 2 or x.shape[0] != 1 or x.shape[1] not in _WIDTHS or x.dtype != torch.bfloat16:
+        raise ValueError("Expected one BF16 activation row of width 2304 or 3072")
+    if out_dtype not in (torch.bfloat16, torch.float32):
+        raise ValueError("Projection output dtype must be BF16 or FP32")
+    if soft_cap and (out_dtype != torch.float32 or soft_cap < 0 or not isfinite(soft_cap)):
+        raise ValueError("Softcap requires a positive finite cap and FP32 output")
+    if num_warps not in (2, 4):
+        raise ValueError("W6 projection requires two or four waves per workgroup")
+    group_size = _packed_group_size(x, pair, third, scales)
+    width = x.shape[1]
+    n = pair.shape[0]
+
+    if not x.is_cuda:
+        group_count = width // group_size
+        words = (pair, pair >> 32, third.long())
+        codes = [(word >> shift) & 63 for word in words for shift in range(0, 30, 6)]
+        last = ((words[0] >> 30) & 3) | ((words[1] >> 28) & 12) | ((words[2] >> 26) & 48)
+        codes = torch.stack([*codes, last], dim=-1).reshape(n, group_count, group_size)
+        signed = ((codes + 32) % 64 - 32).float()
+        products = signed * x.float().reshape(group_count, group_size)
+        result = (products.sum(dim=-1) * scales.float()).sum(dim=1, keepdim=True).T
+        if soft_cap:
+            result = (result / soft_cap).tanh() * soft_cap
+        return result.to(out_dtype)
+
+    result = x.new_empty((1, n), dtype=out_dtype)
+    if n:
+        _groupwise_w6_head_gemv[(triton.cdiv(n, num_warps),)](
+            x.contiguous(), pair, third, scales, result, n, width, group_size, num_warps,
+            soft_cap, num_warps=num_warps,
+        )
+    return result
+
+
+def _use_batched_dot2(x: torch.Tensor, tile_m: int) -> bool:
+    return (
+        tile_m == 8
+        and os.environ.get("INKLING_AMD_W6_BATCH_DOT2") == "1"
+        and torch.version.hip is not None
+        and torch.cuda.get_device_properties(x.device).gcnArchName.split(":", 1)[0] == "gfx1151"
+    )
+
+
+def groupwise_w6_head_batched_linear(
+    x: torch.Tensor, pair: torch.Tensor, third: torch.Tensor, scales: torch.Tensor,
+    *, out_dtype: torch.dtype = torch.float32, num_warps: int = 4, soft_cap: float = 0.0,
+    tile_m: int = 4,
+) -> torch.Tensor:
+    """Project up to eight BF16 tokens using the same W6 bank and row arithmetic."""
+    if x.ndim != 2 or not 1 <= x.shape[0] <= 8 or x.shape[1] not in _WIDTHS or x.dtype != torch.bfloat16:
+        raise ValueError("Expected 1–8 BF16 activation rows of width 2304 or 3072")
+    if tile_m not in (2, 4, 8):
+        raise ValueError("The batched W6 tile must contain two, four or eight tokens")
+    if out_dtype not in (torch.bfloat16, torch.float32):
+        raise ValueError("Projection output dtype must be BF16 or FP32")
+    if soft_cap and (out_dtype != torch.float32 or soft_cap < 0 or not isfinite(soft_cap)):
+        raise ValueError("Softcap requires a positive finite cap and FP32 output")
+    if num_warps not in (2, 4):
+        raise ValueError("W6 projection requires two or four waves per workgroup")
+
+    m, width = x.shape
+    if m == 1 or not x.is_cuda:
+        rows = [
+            groupwise_w6_head_linear(
+                row, pair, third, scales, out_dtype=out_dtype, num_warps=num_warps, soft_cap=soft_cap,
+            )
+            for row in x.split(1)
+        ]
+        return rows[0] if m == 1 else torch.cat(rows)
+
+    group_size = _packed_group_size(x, pair, third, scales)
+    n = pair.shape[0]
+    result = x.new_empty((m, n), dtype=out_dtype)
+    if n:
+        _groupwise_w6_head_batched_gemv[(triton.cdiv(n, num_warps), triton.cdiv(m, tile_m))](
+            x.contiguous(), pair, third, scales, result, m, n, width, group_size, num_warps,
+            tile_m, soft_cap, _use_batched_dot2(x, tile_m), num_warps=num_warps,
+        )
+    return result
+
+
+def groupwise_w6_qkv_gemv(
+    x_q: torch.Tensor, x_k: torch.Tensor, x_v: torch.Tensor,
+    pair: torch.Tensor, third: torch.Tensor, scales: torch.Tensor, ends: tuple[int, int, int],
+    *, num_warps: int = 4,
+) -> torch.Tensor:
+    """Project three M1 inputs over workgroup-aligned ranges to BF16."""
+    if x_q.ndim != 2 or x_q.shape[1] not in _WIDTHS:
+        raise ValueError("Expected W6 activation width 2304 or 3072")
+    if num_warps not in (2, 4):
+        raise ValueError("W6 projection requires two or four waves per workgroup")
+    width = x_q.shape[1]
+    activations = (x_q, x_k, x_v)
+    if any(
+        x.shape != (1, width) or x.dtype != torch.bfloat16
+        or x.device != x_q.device or not x.is_contiguous()
+        for x in activations
+    ):
+        raise ValueError("Expected three contiguous BF16 activation rows on the same device")
+    group_size = _packed_group_size(x_q, pair, third, scales)
+    q_end, k_end, v_end = ends
+    if not (0 < q_end < k_end < v_end <= pair.shape[0]) or any(end % num_warps for end in ends):
+        raise ValueError("Q/K/V row ranges must end on workgroup row boundaries")
+
+    if not x_q.is_cuda:
+        return torch.cat([
+            groupwise_w6_head_linear(
+                x, pair[start:end], third[start:end], scales[start:end], out_dtype=torch.bfloat16,
+                num_warps=num_warps,
+            )
+            for x, start, end in zip(activations, (0, q_end, k_end), ends)
+        ], dim=-1)
+
+    result = x_q.new_empty((1, v_end))
+    _groupwise_w6_qkv_gemv[(v_end // num_warps,)](
+        x_q, x_k, x_v, pair, third, scales, result, q_end, k_end, v_end, width, group_size,
+        num_warps, num_warps=num_warps,
+    )
+    return result
+
+
+def groupwise_w6_qkv_batched(
+    x_q: torch.Tensor, x_k: torch.Tensor, x_v: torch.Tensor,
+    pair: torch.Tensor, third: torch.Tensor, scales: torch.Tensor, ends: tuple[int, int, int],
+    *, num_warps: int = 4, tile_m: int = 4,
+) -> torch.Tensor:
+    """Project the Q/R, K and V workgroup-aligned ranges for up to eight BF16 tokens."""
+    if x_q.ndim != 2 or not 1 <= x_q.shape[0] <= 8 or x_q.shape[1] not in _WIDTHS:
+        raise ValueError("Expected 1–8 W6 activation rows of width 2304 or 3072")
+    if num_warps not in (2, 4):
+        raise ValueError("W6 projection requires two or four waves per workgroup")
+    if tile_m not in (2, 4, 8):
+        raise ValueError("The batched W6 tile must contain two, four or eight tokens")
+    activations = (x_q, x_k, x_v)
+    if any(x.shape != x_q.shape or x.dtype != torch.bfloat16
+           or x.device != x_q.device or not x.is_contiguous() for x in activations):
+        raise ValueError("Expected three equal-shaped contiguous BF16 inputs on the same device")
+    m, width = x_q.shape
+    if m == 1:
+        return groupwise_w6_qkv_gemv(*activations, pair, third, scales, ends, num_warps=num_warps)
+    group_size = _packed_group_size(x_q, pair, third, scales)
+    q_end, k_end, v_end = ends
+    if not (0 < q_end < k_end < v_end <= pair.shape[0]) or any(end % num_warps for end in ends):
+        raise ValueError("Q/K/V row ranges must end on workgroup row boundaries")
+    if not x_q.is_cuda:
+        return torch.cat([
+            groupwise_w6_qkv_gemv(*rows, pair, third, scales, ends, num_warps=num_warps)
+            for rows in zip(*(x.split(1) for x in activations))
+        ], dim=0)
+
+    result = x_q.new_empty((m, v_end))
+    _groupwise_w6_qkv_batched_gemv[(v_end // num_warps, triton.cdiv(m, tile_m))](
+        *activations, pair, third, scales, result, q_end, k_end, m, v_end, width,
+        group_size, num_warps, tile_m, _use_batched_dot2(x_q, tile_m), num_warps=num_warps,
+    )
+    return result
